[Unit]
Description=Antigravity Loopback Quota & Auth Failover Proxy
Documentation=https://github.com/google/antigravity
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/agy-proxy --listen 127.0.0.1:51128 --vault /etc/antigravity/vault.enc
Restart=always
RestartSec=3s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
